---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style is:global>
			body.home .site-logo { display: none !important; }
			body.home header   { padding-top: 0 !important; padding-bottom: 0 !important; }
		</style>
		<style>
			:root {
				--bolt-core:  #362d7a;
				--bolt-a:     #b7abf2;
				--bolt-b:     #a9e6ef;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--bolt-core: #f5f3ff;
					--bolt-a:    #8b7cff;
					--bolt-b:    #58d6ff;
				}
			}
			body {
				display: flex;
				flex-direction: column;
				height: 100vh;
				overflow: hidden;
			}
			main {
				flex: 1;
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				animation: none; /* override global fade-in — the mark has its own */
			}
			.stage {
				position: relative;
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				touch-action: none;
				cursor: crosshair;
			}
			canvas {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				pointer-events: none;
			}
			.mark-wrap {
				position: relative;
				z-index: 2;
				will-change: transform;
				transform-style: preserve-3d;
				perspective: 800px;
				animation: markIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
			}
			@keyframes markIn {
				from { opacity: 0; transform: scale(0.97); }
				to   { opacity: 1; transform: scale(1); }
			}
			.splash-logo {
				display: block;
				width: auto;
				max-width: min(520px, 80vw);
				height: auto;
				opacity: 0.88;
				transition: opacity 0.2s ease, filter 120ms ease-out;
				animation: breathe 6s ease-in-out infinite;
				user-select: none;
				-webkit-user-drag: none;
			}
			.splash-logo:hover {
				opacity: 1;
			}
			.splash-logo.charged {
				filter: drop-shadow(0 0 16px var(--bolt-a)) drop-shadow(0 0 3px var(--bolt-core));
			}
			@keyframes breathe {
				0%, 100% { transform: translateY(0) scale(1); }
				50%      { transform: translateY(-4px) scale(1.008); }
			}
			@media (prefers-reduced-motion: reduce) {
				.mark-wrap { animation: none; }
				.splash-logo { animation: none; }
			}
		</style>
	</head>
	<body class="home">
		<Header />
		<main>
			<div class="stage" id="stage">
				<canvas id="fx"></canvas>
				<div class="mark-wrap" id="markWrap">
					<img src="/logo.webp" alt={SITE_TITLE} class="splash-logo" id="mark" draggable="false" />
				</div>
			</div>
			<span class="sr-only">
				Move your cursor near the mark, or press and hold it, for an animated lightning effect.
			</span>
		</main>
		<Footer />
		<script src="../scripts/lightning.ts"></script>
	</body>
</html>
