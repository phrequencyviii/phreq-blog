---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE_DESCRIPTION } from '../consts';

interface MediaEntry {
	type: 'tv' | 'movie' | 'book' | 'music' | 'comic';
	title: string;
	artist?: string;
	year: number;
	rating?: number;  // 0–5
	notes?: string;
	cover?: string;   // filename in public/medialog/
}

// Library-style sorting: a leading article is ignored, so "The Batman" files
// under B and "An Officer…" under O. The title itself still displays in full.
// The trailing \s+ is load-bearing — it stops the "A" in a title like
// "A.M G.O.D" (no space after it) from being treated as an article.
const sortTitle = (title: string) => title.replace(/^(the|an|a)\s+/i, '');

// Auto-picks up new year files without any code changes
const yearModules = import.meta.glob<{ default: MediaEntry[] }>(
	'../data/medialog/*.json',
	{ eager: true },
);
const allEntries: MediaEntry[] = Object.values(yearModules)
	.flatMap((m) => m.default)
	// `numeric` keeps "10 Things…" ordering sanely against letters;
	// `sensitivity: 'base'` makes it case- and accent-insensitive.
	.sort((a, b) =>
		sortTitle(a.title).localeCompare(sortTitle(b.title), 'en', {
			sensitivity: 'base',
			numeric: true,
		}),
	);

const byType = {
	music: allEntries.filter((e) => e.type === 'music'),
	tv:    allEntries.filter((e) => e.type === 'tv'),
	movie: allEntries.filter((e) => e.type === 'movie'),
	book:  allEntries.filter((e) => e.type === 'book'),
	comic: allEntries.filter((e) => e.type === 'comic'),
};

function stars(n: number) {
	return '★'.repeat(n) + '☆'.repeat(5 - n);
}

const sections = [
	{ key: 'music' as const, label: 'Music',    id: 'music',  note: 'As you can tell… I like metal a lot.' },
	{ key: 'tv'    as const, label: 'TV Shows', id: 'tv',     note: "I'm not a big TV watcher and I tend to rewatch the same crap over and over for background noise, so this isn't going to impress anyone." },
	{ key: 'comic' as const, label: 'Comics',   id: 'comics', note: undefined },
	{ key: 'movie' as const, label: 'Movies',   id: 'movies', note: "Same with movies, everything I like tends to be light and I'm pretty easy to please." },
	{ key: 'book'  as const, label: 'Books',    id: 'books',  note: undefined },
];

const visibleSections = sections.filter(({ key }) => byType[key].length > 0);
// Only the top of the first rendered section is above the fold; everything
// else lazy-loads. Keeps the initial payload to one screen of covers.
const eagerKey = visibleSections[0]?.key;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Medialog" description={SITE_DESCRIPTION} />
		<style>
			.jump-nav {
				display: flex;
				gap: 0.5em;
				align-items: center;
				flex-wrap: wrap;
				padding-top: 0.75em;
				border-top: 1px solid var(--border);
			}
			.jump-nav a {
				font-family: var(--font-mono);
				font-size: 0.68em;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: rgb(var(--gray));
				text-decoration: none;
				transition: color 0.2s ease;
			}
			.jump-nav a:hover {
				color: var(--accent);
			}
			.games-link {
				font-family: var(--font-mono);
				font-size: 0.78em;
				color: rgb(var(--gray));
				letter-spacing: 0.04em;
				margin: 0;
			}
			.games-link a {
				color: rgb(var(--gray));
				transition: color 0.2s ease;
			}
			.games-link a:hover {
				color: var(--accent);
			}
			.jump-nav .sep {
				color: rgb(var(--gray));
				opacity: 0.4;
				font-size: 0.7em;
			}

			/* ── Section shell ── */
			.section {
				margin-bottom: 3em;
			}
			.section-title {
				font-family: var(--font-mono);
				font-size: 0.68em;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--gray-dark));
				margin-bottom: 0.75em;
				padding-bottom: 0.5em;
				border-bottom: 1px solid var(--border);
				display: flex;
				align-items: baseline;
				gap: 0.5em;
			}
			.count {
				opacity: 0.6;
			}
			.empty {
				font-family: var(--font-mono);
				font-size: 0.72em;
				color: rgb(var(--gray));
				letter-spacing: 0.04em;
				padding: 0.5em 0;
			}

			.section-note {
				font-family: var(--font-mono);
				font-size: 0.65em;
				color: rgb(var(--gray));
				letter-spacing: 0.03em;
				margin: 0 0 1.25em;
			}

			/* ── Shared card grid ── */
			.card-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(80px, 100px));
				gap: 1em;
				justify-content: start;
				margin-top: 0.5em;
			}
			.media-card {
				display: flex;
				flex-direction: column;
				gap: 0.4em;
			}
			.media-card .cover {
				width: 100%;
				object-fit: cover;
				border-radius: 2px;
				display: block;
				background: rgb(var(--gray-light));
			}
			.media-card .cover.square    { aspect-ratio: 1; }
			.media-card .cover.portrait  { aspect-ratio: 2 / 3; }
			.media-card .cover-placeholder {
				width: 100%;
				background: rgb(var(--gray-light));
				border-radius: 2px;
			}
			.media-card .cover-placeholder.square   { aspect-ratio: 1; }
			.media-card .cover-placeholder.portrait { aspect-ratio: 2 / 3; }
			.media-card .card-title {
				font-size: 0.78em;
				color: rgb(var(--black));
				line-height: 1.3;
				margin: 0;
				font-family: var(--font-inter);
				font-weight: 500;
				/* Clamp to 2 lines so every card is the same height and the star
				   rows stay aligned across a grid row. Full title stays in the DOM
				   (and in the img alt) for search and screen readers. */
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				/* Always reserve both lines, so a one-line title doesn't shorten the card. */
				min-height: calc(2 * 1.3em);
			}
			.media-card .card-sub {
				font-family: var(--font-mono);
				font-size: 0.65em;
				color: rgb(var(--gray));
				letter-spacing: 0.03em;
				/* One line only — a long artist name must not shift the stars down. */
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.media-card .card-meta {
				font-family: var(--font-mono);
				font-size: 0.8em;
				color: rgb(var(--gray));
				letter-spacing: 0.04em;
				/* Pinned to the bottom so ratings line up even when a card above
				   is missing an artist line. */
				margin-top: auto;
			}

			@media (max-width: 720px) {
				.card-grid {
					grid-template-columns: repeat(auto-fill, minmax(75px, 1fr));
					gap: 0.75em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<PageHeader title="Medialog">
				<p>I decided to start tracking down stuff I've read, watched, and listened to, as well as a quick little star rating. All the big platforms and apps that help track this stuff end up getting enshittified, sold off, or closed down anyways, so I'll just do it myself. I started tracking as of 2026. My head would explode if I tried to track everything prior to that.</p>
				<nav class="jump-nav">
					{[{ label: 'Video Games', id: 'games' }, ...sections.filter(s => byType[s.key].length > 0)].map(({ label, id }, i, arr) => (
						<>
							<a href={`#${id}`}>{label}</a>
							{i < arr.length - 1 && <span class="sep">·</span>}
						</>
					))}
				</nav>
			</PageHeader>

			<section class="section" id="games">
				<div class="section-title">Video Games</div>
				<p class="games-link">
					Tracked on my gaming blog, <a href="https://deprecated.games/completed/" target="_blank" rel="noopener">see here →</a>
				</p>
			</section>

			{visibleSections.map(({ key, label, id, note }) => (
				<section class="section" id={id}>
					<div class="section-title">{label}</div>
					{note && <p class="section-note">{note}</p>}

					{byType[key].length === 0 ? (
						<p class="empty">nothing logged yet</p>
					) : (
						<div class="card-grid">
							{byType[key].map((entry, i) => (
								<div class="media-card">
									{entry.cover
										? <img
												src={`/medialog/${entry.cover}`}
												alt={entry.title}
												loading={key === eagerKey && i < 12 ? 'eager' : 'lazy'}
												decoding="async"
												class:list={['cover', key === 'music' ? 'square' : 'portrait']}
											/>
										: <div class:list={['cover-placeholder', key === 'music' ? 'square' : 'portrait']} />
									}
									<div class="card-title">{entry.title}</div>
									{entry.artist && <div class="card-sub">{entry.artist}</div>}
									{entry.rating != null && <div class="card-meta">{stars(entry.rating)}</div>}
								</div>
							))}
						</div>
					)}
				</section>
			))}
		</main>
		<Footer />
	</body>
</html>
