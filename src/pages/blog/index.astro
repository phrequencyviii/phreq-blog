---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const sorted = (await getCollection('posts')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Microposts render their body inline in the feed (there's no title to
// link off of), so render them up front rather than per-item in the loop.
const posts = await Promise.all(
	sorted.map(async (post) => ({
		post,
		Content: post.data.type === 'micro' ? (await render(post)).Content : null,
	})),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Posts — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			ul li a:not(.micro) {
				display: flex;
				gap: 1rem;
				align-items: flex-start;
				text-decoration: none;
			}
			ul li a:hover .title {
				color: var(--accent);
			}
			.thumb {
				width: 100px;
				height: 70px;
				object-fit: cover;
				border-radius: 8px;
				flex-shrink: 0;
			}
			.info {
				flex: 1;
			}
			.title {
				margin: 0 0 0.25em;
				color: rgb(var(--black));
				font-size: 1.1em;
				line-height: 1.3;
				transition: color 0.2s;
			}
			.description {
				margin: 0 0 0.25em;
				color: rgb(var(--gray-dark));
				font-size: 0.9em;
				line-height: 1.4;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			.micro {
				position: relative;
				display: block;
				padding: 0.9em 1em;
				border: 1px solid var(--border);
				border-radius: 8px;
			}
			.micro:hover {
				border-color: var(--accent);
			}
			.micro .date {
				margin: 0 0 0.5em;
				font-family: var(--font-mono);
				font-size: 0.72em;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}
			.micro .permalink {
				color: inherit;
				text-decoration: none;
			}
			/* Stretches the timestamp link to cover the whole card (the
			   "stretched link" pattern), so the card stays fully clickable
			   without wrapping the rendered body — which can contain its
			   own links — inside another <a>. */
			.micro .permalink::after {
				content: '';
				position: absolute;
				inset: 0;
				z-index: 1;
			}
			.micro .micro-body {
				color: rgb(var(--black));
				font-size: 1em;
				line-height: 1.5;
			}
			/* Only real links inside the body get lifted above the
			   stretched permalink overlay — the surrounding plain text
			   stays static (below it) so the rest of the card still
			   navigates to the permalink when clicked. */
			.micro .micro-body :global(a) {
				position: relative;
				z-index: 2;
				color: var(--link-color);
			}
			.micro .micro-body :global(p) {
				margin: 0 0 0.6em;
			}
			.micro .micro-body :global(p:last-child) {
				margin-bottom: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="sr-only">Posts</h1>
			<section>
				<ul>
					{
						posts.map(({ post, Content }) =>
							post.data.type === 'micro' ? (
								<li class="micro">
									<p class="date">
										<a class="permalink" href={`/blog/${post.id}/`}>
											<FormattedDate date={post.data.pubDate} />
										</a>
									</p>
									<div class="micro-body">
										<Content />
									</div>
								</li>
							) : (
								<li>
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<img
												class="thumb"
												width="200"
												height="140"
												src={post.data.heroImage}
												alt=""
												loading="lazy"
											/>
										)}
										<div class="info">
											<h4 class="title">{post.data.title}</h4>
											{post.data.description && (
												<p class="description">{post.data.description}</p>
											)}
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							),
						)
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
