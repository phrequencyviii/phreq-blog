/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

# CSP is scoped to the known public routes only, not /admin. Sveltia CMS
# pulls its editor from unpkg.com and talks to GitHub's API/avatar/raw
# domains at runtime, and that's a moving target we don't track here — safer
# to leave /admin with no CSP (unchanged from before) than ship one that's
# wrong and breaks the CMS, or risk two rules matching the same request.
# `/about*`/`/blog*`/`/medialog*` (no slash before the splat) match both the
# bare path and everything nested under it in one line.
/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/about*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/blog*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/medialog*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Contact form needs Turnstile's script and challenge iframe, both served
# from challenges.cloudflare.com — everything else stays as locked down as
# the other routes above. Turnstile's loader also injects two small inline
# bootstrap scripts; script-src allowlists them by hash (found via the CSP
# violation reports Turnstile logs to the console when they're blocked)
# rather than opening script-src up with 'unsafe-inline'.
/contact*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com 'sha256-uYLDSe5NTGaXqi19GwEI9sHZ4YBpchBZpKzComnz/K4=' 'sha256-CSFUre8nxnj6NHRQniGaYa3yBjQYPr11rUN96ps+3ZQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
